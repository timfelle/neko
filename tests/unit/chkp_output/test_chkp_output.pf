module test_chkp_output
  use pfunit
  use checkpoint, only : chkp_t
  use chkp_output, only : chkp_output_t
  use device, only : device_init, device_finalize
  use neko_config, only : NEKO_BCKND_DEVICE
  implicit none

  @TestCase
  type, extends(TestCase) :: test_chkp_output_case
   contains
     procedure :: setUp
     procedure :: tearDown
  end type test_chkp_output_case

contains

  subroutine setUp(this)
    class(test_chkp_output_case), intent(inout) :: this

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_init
    end if
  end subroutine setUp

  subroutine tearDown(this)
    class(test_chkp_output_case), intent(inout) :: this

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_finalize
    end if
  end subroutine tearDown

  !> Verify that a path without a trailing slash is joined to the file name
  !! with a separator.
  @test
  subroutine test_path_without_slash_gets_separator(this)
    class(test_chkp_output_case), intent(inout) :: this
    type(chkp_t), target :: chkp
    type(chkp_output_t) :: chkp_out

    call chkp_out%init(chkp, name = 'fluid', path = 'outdir')
    @assertEqual('outdir/fluid.chkp', trim(chkp_out%file_%get_fname()))
    call chkp_out%free()
  end subroutine test_path_without_slash_gets_separator

  !> Verify that a path with a trailing slash gets no second separator.
  @test
  subroutine test_path_with_slash_keeps_one(this)
    class(test_chkp_output_case), intent(inout) :: this
    type(chkp_t), target :: chkp
    type(chkp_output_t) :: chkp_out

    call chkp_out%init(chkp, name = 'fluid', path = 'outdir/')
    @assertEqual('outdir/fluid.chkp', trim(chkp_out%file_%get_fname()))
    call chkp_out%free()
  end subroutine test_path_with_slash_keeps_one

  !> Verify that a path padded with blanks, as passed from a fixed-length
  !! variable, is joined with a separator after its last character.
  @test
  subroutine test_padded_path_gets_separator(this)
    class(test_chkp_output_case), intent(inout) :: this
    type(chkp_t), target :: chkp
    type(chkp_output_t) :: chkp_out
    character(len=256) :: path

    path = 'outdir'
    call chkp_out%init(chkp, name = 'fluid', path = path)
    @assertEqual('outdir/fluid.chkp', trim(chkp_out%file_%get_fname()))
    call chkp_out%free()
  end subroutine test_padded_path_gets_separator

  !> Verify that an empty path, the default output directory of a case,
  !! leaves the file name without a directory.
  @test
  subroutine test_empty_path_gives_bare_name(this)
    class(test_chkp_output_case), intent(inout) :: this
    type(chkp_t), target :: chkp
    type(chkp_output_t) :: chkp_out

    call chkp_out%init(chkp, name = 'fluid', path = '')
    @assertEqual('fluid.chkp', trim(chkp_out%file_%get_fname()))
    call chkp_out%free()
  end subroutine test_empty_path_gives_bare_name

end module test_chkp_output
