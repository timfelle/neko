USEMPI=YES
ifneq ("$(wildcard @PFUNIT_DIR@/include/PFUNIT.mk)", "")
include @PFUNIT_DIR@/include/PFUNIT.mk
endif
FFLAGS += $(PFUNIT_EXTRA_FFLAGS) @NEKO_PKG_FCFLAGS@ -I@top_builddir@/src
FC = @FC@

# Rebuild against the library, not just against the test source. Without
# this the suite is happily left linked to a stale libneko, which quietly
# invalidates any comparison drawn from running it.
NEKO_LIB := $(wildcard @top_builddir@/src/libneko.la)

%.o : %.F90 $(NEKO_LIB)
	$(FC) -c $(FFLAGS) $<


check: restart_consistency_hdf5_suite


restart_consistency_hdf5_suite_TESTS := test_restart_consistency_hdf5.pf
restart_consistency_hdf5_suite_OTHER_LIBRARIES = -L@top_builddir@/src/.libs -lneko @LDFLAGS@ @LIBS@
$(eval $(call make_pfunit_test,restart_consistency_hdf5_suite))

distclean:
clean:
	$(RM) *.o *.mod *.a  *.inc *.F90 restart_consistency_hdf5_suite *.nmsh *.chkp *.h5



all:
html:
install:
distdir:
