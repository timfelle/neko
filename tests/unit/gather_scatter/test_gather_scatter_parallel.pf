module test_gather_scatter_parallel
  use mpi
  use pfunit
  use dofmap
  use space
  use mesh
  use num_types
  use field
  use math
  use hex
  use point
  use datadist
  use gather_scatter
  use device
  use neko_config
  use comm, only : NEKO_COMM, pe_rank, pe_size
  use pfunit_comm_utils, only : comm_init_test, comm_free_test
  implicit none

  @TestCase
  type, extends(MPITestCase) :: test_gather_scatter
   contains
     procedure :: setUp
     procedure :: tearDown
  end type test_gather_scatter

contains
  subroutine setUp(this)
    class(test_gather_scatter), intent(inout) :: this
    call comm_init_test(this%getMpiCommunicator())
  end subroutine setUp

  subroutine tearDown(this)
    class(test_gather_scatter), intent(inout) :: this
    call comm_free_test()
  end subroutine tearDown

  @test(npes=[1])
  subroutine test_dofmap_face12(this)
    class (test_gather_scatter), intent(inout) :: this
    type(dofmap_t) :: d
    type(mesh_t) :: m
    type(field_t) :: x
    type(gs_t) :: gs_h
    type(linear_dist_t) :: dist
    type(space_t) :: Xh
    type(point_t) :: p(12)
    integer :: ierr, i,j, lx, n
    integer, parameter :: gdim = 3
    lx = 5

    call device_init

    dist = linear_dist_t(2, this%getProcessRank(), &
         this%getNumProcesses(), NEKO_COMM)

    call p(1)%init(0d0, 0d0, 0d0)
    call p(1)%set_id(1)
    call p(2)%init(1d0, 0d0, 0d0)
    call p(2)%set_id(2)
    call p(3)%init(0d0, 1d0, 0d0)
    call p(3)%set_id(4)
    call p(4)%init(1d0, 1d0, 0d0)
    call p(4)%set_id(3)
    call p(5)%init(2d0, 0d0, 0d0)
    call p(5)%set_id(5)
    call p(6)%init(2d0, 1d0, 0d0)
    call p(6)%set_id(6)
    call p(7)%init(0d0, 0d0, 1d0)
    call p(7)%set_id(7)
    call p(8)%init(1d0, 0d0, 1d0)
    call p(8)%set_id(8)
    call p(9)%init(1d0, 1d0, 1d0)
    call p(9)%set_id(9)
    call p(10)%init(0d0, 1d0, 1d0)
    call p(10)%set_id(10)
    call p(11)%init(2d0, 0d0, 1d0)
    call p(11)%set_id(11)
    call p(12)%init(2d0, 1d0, 1d0)
    call p(12)%set_id(12)

    call m%init(gdim, dist)
    Call Xh%init(GLL, lx,lx,lx)

    call m%add_element(1, 1, p(1), p(2), p(4), p(3), &
         p(5), p(6), p(8), p(7))

    call m%add_element(2, 2, p(2), p(9), p(3), p(10), &
         p(6), p(11), p(7), p(12))

    call m%generate_conn()

    call d%init(m, Xh)
    call gs_h%init(d)
    call x%init(m, Xh, "x")
    n = Xh%lx * Xh%ly * Xh%lz * m%nelv

    !> Test GS_OP_ADD
    call rone(x%x, n)
    call add2(x%x, real(d%dof, rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_ADD)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(lx,j,i,1), x%x(1,j,i,2),tolerance=epsilon(1.0_rp))
       end do
    end do

    !> Test GS_OP_MIN
    call rone(x%x, n)
    ! Multiply by dof create different values from both sides
    call col2(x%x, real(d%dof, rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_MIN)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    ! Checks if values match at shared face between elements
    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(lx,j,i,1), x%x(1,j,i,2), tolerance=epsilon(1.0_rp))
       end do
    end do

    !> Test GS_OP_MAX
    call rone(x%x, n)
    ! Multiply by dof create different values from both sides
    call col2(x%x,real(d%dof,rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_MAX)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    ! Checks if values match at shared face between elements
    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(lx,j,i,1), x%x(1,j,i,2),tolerance=epsilon(1.0_rp))
       end do
    end do

    call device_finalize

  end subroutine test_dofmap_face12


  @test(npes=[1])
  subroutine test_dofmap_face15(this)
    class (test_gather_scatter), intent(inout) :: this
    type(dofmap_t) :: d
    type(mesh_t) :: m
    type(field_t) :: x
    type(gs_t) :: gs_h
    type(linear_dist_t) :: dist
    type(space_t) :: Xh
    type(point_t) :: p(12)
    integer :: ierr, i,j, lx, n
    integer, parameter :: gdim = 3
    lx = 5

    call device_init

    dist = linear_dist_t(2, this%getProcessRank(), &
         this%getNumProcesses(), NEKO_COMM)

    call p(1)%init(0d0, 0d0, 0d0)
    call p(1)%set_id(1)
    call p(2)%init(1d0, 0d0, 0d0)
    call p(2)%set_id(2)
    call p(3)%init(0d0, 1d0, 0d0)
    call p(3)%set_id(4)
    call p(4)%init(1d0, 1d0, 0d0)
    call p(4)%set_id(3)
    call p(5)%init(2d0, 0d0, 0d0)
    call p(5)%set_id(5)
    call p(6)%init(2d0, 1d0, 0d0)
    call p(6)%set_id(6)
    call p(7)%init(0d0, 0d0, 1d0)
    call p(7)%set_id(7)
    call p(8)%init(1d0, 0d0, 1d0)
    call p(8)%set_id(8)
    call p(9)%init(1d0, 1d0, 1d0)
    call p(9)%set_id(9)
    call p(10)%init(0d0, 1d0, 1d0)
    call p(10)%set_id(10)
    call p(11)%init(2d0, 0d0, 1d0)
    call p(11)%set_id(11)
    call p(12)%init(2d0, 1d0, 1d0)
    call p(12)%set_id(12)

    call m%init(gdim, dist)
    Call Xh%init(GLL, lx,lx,lx)


    call m%add_element(1, 1, p(5), p(1), p(8), p(4), &
         p(6), p(2), p(7), p(3))
    call m%add_element(2, 2, p(2), p(9), p(3), p(10), &
         p(6), p(11), p(7), p(12))
    call m%generate_conn()

    call d%init(m, Xh)
    call gs_h%init(d)
    call x%init(m, Xh, "x")
    n = Xh%lx * Xh%ly * Xh%lz * m%nelv

    !> Test GS_OP_ADD
    call rone(x%x, n)
    call add2(x%x,real(d%dof,rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_ADD)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(lx+1-i,j,lx,1), x%x(1,j,i,2), tolerance=epsilon(1.0_rp))
       end do
    end do

    !> Test GS_OP_MIN
    call rone(x%x, n)
    call col2(x%x,real(d%dof,rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_MIN)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(lx+1-i,j,lx,1), x%x(1,j,i,2), tolerance=epsilon(1.0_rp))
       end do
    end do

    !> Test GS_OP_MAX
    call rone(x%x, n)
    call col2(x%x, real(d%dof, rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_MAX)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(lx+1-i,j,lx,1), x%x(1,j,i,2), tolerance=epsilon(1.0_rp))
       end do
    end do

    call device_finalize

  end subroutine test_dofmap_face15

  @test(npes=[1])
  subroutine test_dofmap_face11(this)
    class (test_gather_scatter), intent(inout) :: this
    type(dofmap_t) :: d
    type(mesh_t) :: m
    type(field_t) :: x
    type(gs_t) :: gs_h
    type(linear_dist_t) :: dist
    type(space_t) :: Xh
    type(point_t) :: p(12)
    integer :: ierr, i,j, lx, n
    integer, parameter :: gdim = 3
    lx = 5

    call device_init

    dist = linear_dist_t(2, this%getProcessRank(), &
         this%getNumProcesses(), NEKO_COMM)

    call p(1)%init(0d0, 0d0, 0d0)
    call p(1)%set_id(1)
    call p(2)%init(1d0, 0d0, 0d0)
    call p(2)%set_id(2)
    call p(3)%init(0d0, 1d0, 0d0)
    call p(3)%set_id(4)
    call p(4)%init(1d0, 1d0, 0d0)
    call p(4)%set_id(3)
    call p(5)%init(2d0, 0d0, 0d0)
    call p(5)%set_id(5)
    call p(6)%init(2d0, 1d0, 0d0)
    call p(6)%set_id(6)
    call p(7)%init(0d0, 0d0, 1d0)
    call p(7)%set_id(7)
    call p(8)%init(1d0, 0d0, 1d0)
    call p(8)%set_id(8)
    call p(9)%init(1d0, 1d0, 1d0)
    call p(9)%set_id(9)
    call p(10)%init(0d0, 1d0, 1d0)
    call p(10)%set_id(10)
    call p(11)%init(2d0, 0d0, 1d0)
    call p(11)%set_id(11)
    call p(12)%init(2d0, 1d0, 1d0)
    call p(12)%set_id(12)

    call m%init(gdim, dist)
    Call Xh%init(GLL, lx,lx,lx)


    call m%add_element(1, 1, p(7), p(8), p(6), p(5), &
         p(3), p(4), p(2), p(1))
    call m%add_element(2, 2, p(2), p(9), p(3), p(10), &
         p(6), p(11), p(7), p(12))

    call m%generate_conn()
    call d%init(m, Xh)
    call gs_h%init(d)
    call x%init(m, Xh, "x")
    n = Xh%lx * Xh%ly * Xh%lz * m%nelv

    !> Test GS_OP_ADD
    call rone(x%x, n)
    call add2(x%x, real(d%dof, rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_ADD)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(1,lx+1-j,lx+1-i,1), x%x(1,j,i,2), tolerance=epsilon(1.0_rp))
       end do
    end do

    !> Test GS_OP_MIN
    call rone(x%x, n)
    call col2(x%x, real(d%dof, rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_MIN)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(1,lx+1-j,lx+1-i,1), x%x(1,j,i,2), tolerance=epsilon(1.0_rp))
       end do
    end do

    !> Test GS_OP_MAX
    call rone(x%x, n)
    call col2(x%x, real(d%dof, rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_MAX)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(1,lx+1-j,lx+1-i,1), x%x(1,j,i,2), tolerance=epsilon(1.0_rp))
       end do
    end do

    call device_finalize

  end subroutine test_dofmap_face11

  @test(npes=[1])
  subroutine test_dofmap_face11rot(this)
    class (test_gather_scatter), intent(inout) :: this
    type(dofmap_t) :: d
    type(mesh_t) :: m
    type(field_t) :: x
    type(gs_t) :: gs_h
    type(linear_dist_t) :: dist
    type(space_t) :: Xh
    type(point_t) :: p(12)
    integer :: ierr, i,j, lx, n
    integer, parameter :: gdim = 3
    lx = 5

    call device_init

    dist = linear_dist_t(2, this%getProcessRank(), &
         this%getNumProcesses(), NEKO_COMM)

    call p(1)%init(0d0, 0d0, 0d0)
    call p(1)%set_id(1)
    call p(2)%init(1d0, 0d0, 0d0)
    call p(2)%set_id(2)
    call p(3)%init(0d0, 1d0, 0d0)
    call p(3)%set_id(4)
    call p(4)%init(1d0, 1d0, 0d0)
    call p(4)%set_id(3)
    call p(5)%init(2d0, 0d0, 0d0)
    call p(5)%set_id(5)
    call p(6)%init(2d0, 1d0, 0d0)
    call p(6)%set_id(6)
    call p(7)%init(0d0, 0d0, 1d0)
    call p(7)%set_id(7)
    call p(8)%init(1d0, 0d0, 1d0)
    call p(8)%set_id(8)
    call p(9)%init(1d0, 1d0, 1d0)
    call p(9)%set_id(9)
    call p(10)%init(0d0, 1d0, 1d0)
    call p(10)%set_id(10)
    call p(11)%init(2d0, 0d0, 1d0)
    call p(11)%set_id(11)
    call p(12)%init(2d0, 1d0, 1d0)
    call p(12)%set_id(12)

    call m%init(gdim, dist)
    Call Xh%init(GLL, lx,lx,lx)


    call m%add_element(1, 1, p(6), p(5), p(7), p(8), &
         p(2), p(1), p(3), p(4))
    call m%add_element(2, 2, p(2), p(9), p(3), p(10), &
         p(6), p(11), p(7), p(12))

    call m%generate_conn()
    call d%init(m, Xh)
    call gs_h%init(d)
    call x%init(m, Xh, "x")
    n = Xh%lx * Xh%ly * Xh%lz * m%nelv

    !> Test GS_OP_ADD
    call rone(x%x, n)
    call add2(x%x, real(d%dof, rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_ADD)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(1,j,lx+1-i,1), x%x(1,j,i,2), tolerance=epsilon(1.0_rp))
       end do
    end do

    !> Test GS_OP_MIN
    call rone(x%x, n)
    call col2(x%x, real(d%dof, rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_MIN)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(1,j,lx+1-i,1), x%x(1,j,i,2),tolerance=epsilon(1.0_rp))
       end do
    end do

    !> Test GS_OP_MAX
    call rone(x%x, n)
    call col2(x%x, real(d%dof, rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_MAX)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(1,j,lx+1-i,1), x%x(1,j,i,2),tolerance=epsilon(1.0_rp))
       end do
    end do

    call device_finalize

  end subroutine test_dofmap_face11rot

  @test(npes=[1])
  subroutine test_dofmap_face16(this)
    class (test_gather_scatter), intent(inout) :: this
    type(dofmap_t) :: d
    type(mesh_t) :: m
    type(field_t) :: x
    type(gs_t) :: gs_h
    type(linear_dist_t) :: dist
    type(space_t) :: Xh
    type(point_t) :: p(12)
    integer :: ierr, i,j, lx, n
    integer, parameter :: gdim = 3
    lx = 5

    call device_init

    dist = linear_dist_t(2, this%getProcessRank(), &
         this%getNumProcesses(), NEKO_COMM)

    call p(1)%init(0d0, 0d0, 0d0)
    call p(1)%set_id(1)
    call p(2)%init(1d0, 0d0, 0d0)
    call p(2)%set_id(2)
    call p(3)%init(0d0, 1d0, 0d0)
    call p(3)%set_id(4)
    call p(4)%init(1d0, 1d0, 0d0)
    call p(4)%set_id(3)
    call p(5)%init(2d0, 0d0, 0d0)
    call p(5)%set_id(5)
    call p(6)%init(2d0, 1d0, 0d0)
    call p(6)%set_id(6)
    call p(7)%init(0d0, 0d0, 1d0)
    call p(7)%set_id(7)
    call p(8)%init(1d0, 0d0, 1d0)
    call p(8)%set_id(8)
    call p(9)%init(1d0, 1d0, 1d0)
    call p(9)%set_id(9)
    call p(10)%init(0d0, 1d0, 1d0)
    call p(10)%set_id(10)
    call p(11)%init(2d0, 0d0, 1d0)
    call p(11)%set_id(11)
    call p(12)%init(2d0, 1d0, 1d0)
    call p(12)%set_id(12)

    call m%init(gdim, dist)
    Call Xh%init(GLL, lx,lx,lx)


    call m%add_element(1, 1, p(2), p(6), p(3), p(7), &
         p(1), p(5), p(4), p(8))
    call m%add_element(2, 2, p(2), p(9), p(3), p(10), &
         p(6), p(11), p(7), p(12))

    call m%generate_conn()
    call d%init(m, Xh)
    call gs_h%init(d)
    call x%init(m, Xh, "x")
    n = Xh%lx * Xh%ly * Xh%lz * m%nelv

    !> Test GS_OP_ADD
    call rone(x%x, n)
    call add2(x%x, real(d%dof, rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_ADD)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(i,j,1,1), x%x(1,j,i,2), tolerance=epsilon(1.0_rp))
       end do
    end do

    !> Test GS_OP_MIN
    call rone(x%x, n)
    call col2(x%x, real(d%dof, rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_MIN)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(i,j,1,1), x%x(1,j,i,2), tolerance=epsilon(1.0_rp))
       end do
    end do

    !> Test GS_OP_MAX
    call rone(x%x, n)
    call col2(x%x, real(d%dof, rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_MAX)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(i,j,1,1), x%x(1,j,i,2), tolerance=epsilon(1.0_rp))
       end do
    end do

    call device_finalize

  end subroutine test_dofmap_face16

  @test(npes=[1])
  subroutine test_dofmap_face13(this)
    class (test_gather_scatter), intent(inout) :: this
    type(dofmap_t) :: d
    type(mesh_t) :: m
    type(field_t) :: x
    type(gs_t) :: gs_h
    type(linear_dist_t) :: dist
    type(space_t) :: Xh
    type(point_t) :: p(12)
    integer :: ierr, i,j, lx, n
    integer, parameter :: gdim = 3
    lx = 5

    call device_init

    dist = linear_dist_t(2, this%getProcessRank(), &
         this%getNumProcesses(), NEKO_COMM)

    call p(1)%init(0d0, 0d0, 0d0)
    call p(1)%set_id(1)
    call p(2)%init(1d0, 0d0, 0d0)
    call p(2)%set_id(2)
    call p(3)%init(0d0, 1d0, 0d0)
    call p(3)%set_id(4)
    call p(4)%init(1d0, 1d0, 0d0)
    call p(4)%set_id(3)
    call p(5)%init(2d0, 0d0, 0d0)
    call p(5)%set_id(5)
    call p(6)%init(2d0, 1d0, 0d0)
    call p(6)%set_id(6)
    call p(7)%init(0d0, 0d0, 1d0)
    call p(7)%set_id(7)
    call p(8)%init(1d0, 0d0, 1d0)
    call p(8)%set_id(8)
    call p(9)%init(1d0, 1d0, 1d0)
    call p(9)%set_id(9)
    call p(10)%init(0d0, 1d0, 1d0)
    call p(10)%set_id(10)
    call p(11)%init(2d0, 0d0, 1d0)
    call p(11)%set_id(11)
    call p(12)%init(2d0, 1d0, 1d0)
    call p(12)%set_id(12)

    call m%init(gdim, dist)
    Call Xh%init(GLL, lx,lx,lx)


    call m%add_element(1, 1, p(4), p(1), p(3), p(2), &
         p(8), p(5), p(7), p(6))
    call m%add_element(2, 2, p(2), p(9), p(3), p(10), &
         p(6), p(11), p(7), p(12))

    call m%generate_conn()
    call d%init(m, Xh)
    call gs_h%init(d)
    call x%init(m, Xh, "x")
    n = Xh%lx * Xh%ly * Xh%lz * m%nelv

    !> Test GS_OP_ADD
    call rone(x%x, n)
    call add2(x%x, real(d%dof, rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_ADD)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(lx+1-j,lx,i,1), x%x(1,j,i,2), tolerance=epsilon(1.0_rp))
       end do
    end do

    !> Test GS_OP_MIN
    call rone(x%x, n)
    call col2(x%x, real(d%dof, rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_MIN)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(lx+1-j,lx,i,1), x%x(1,j,i,2), tolerance=epsilon(1.0_rp))
       end do
    end do

    !> Test GS_OP_MAX
    call rone(x%x, n)
    call col2(x%x,real(d%dof,rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_MAX)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(lx+1-j,lx,i,1), x%x(1,j,i,2), tolerance=epsilon(1.0_rp))
       end do
    end do

    call device_finalize

  end subroutine test_dofmap_face13

  @test(npes=[1])
  subroutine test_dofmap_face14(this)
    class (test_gather_scatter), intent(inout) :: this
    type(dofmap_t) :: d
    type(mesh_t) :: m
    type(field_t) :: x
    type(gs_t) :: gs_h
    type(linear_dist_t) :: dist
    type(space_t) :: Xh
    type(point_t) :: p(12)
    integer :: ierr, i,j, lx, n
    integer, parameter :: gdim = 3
    lx = 5

    call device_init

    dist = linear_dist_t(2, this%getProcessRank(), &
         this%getNumProcesses(), NEKO_COMM)

    call p(1)%init(0d0, 0d0, 0d0)
    call p(1)%set_id(1)
    call p(2)%init(1d0, 0d0, 0d0)
    call p(2)%set_id(2)
    call p(3)%init(0d0, 1d0, 0d0)
    call p(3)%set_id(4)
    call p(4)%init(1d0, 1d0, 0d0)
    call p(4)%set_id(3)
    call p(5)%init(2d0, 0d0, 0d0)
    call p(5)%set_id(5)
    call p(6)%init(2d0, 1d0, 0d0)
    call p(6)%set_id(6)
    call p(7)%init(0d0, 0d0, 1d0)
    call p(7)%set_id(7)
    call p(8)%init(1d0, 0d0, 1d0)
    call p(8)%set_id(8)
    call p(9)%init(1d0, 1d0, 1d0)
    call p(9)%set_id(9)
    call p(10)%init(0d0, 1d0, 1d0)
    call p(10)%set_id(10)
    call p(11)%init(2d0, 0d0, 1d0)
    call p(11)%set_id(11)
    call p(12)%init(2d0, 1d0, 1d0)
    call p(12)%set_id(12)

    call m%init(gdim, dist)
    Call Xh%init(GLL, lx,lx,lx)


    call m%add_element(1, 1, p(2), p(3), p(1), p(4), &
         p(6), p(7), p(5), p(8))
    call m%add_element(2, 2, p(2), p(9), p(3), p(10), &
         p(6), p(11), p(7), p(12))

    call m%generate_conn()
    call d%init(m, Xh)
    call gs_h%init(d)
    call x%init(m, Xh, "x")
    n = Xh%lx * Xh%ly * Xh%lz * m%nelv

    !> Test GS_OP_ADD
    call rone(x%x, n)
    call add2(x%x, real(d%dof, rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_ADD)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(j,1,i,1), x%x(1,j,i,2),tolerance=epsilon(1.0_rp))
       end do
    end do

    !> Test GS_OP_MIN
    call rone(x%x, n)
    call col2(x%x, real(d%dof, rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_MIN)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(j,1,i,1), x%x(1,j,i,2), tolerance=epsilon(1.0_rp))
       end do
    end do

    !> Test GS_OP_MAX
    call rone(x%x, n)
    call col2(x%x, real(d%dof, rp), n/2)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), HOST_TO_DEVICE, sync=.false.)
    end if

    call gs_h%op(x%x, n, GS_OP_MAX)

    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(x%x, x%x_d, size(x%x), DEVICE_TO_HOST, sync=.true.)
    end if

    do i = 1,lx
       do j = 1,lx
          @assertEqual(x%x(j,1,i,1), x%x(1,j,i,2),tolerance=epsilon(1.0_rp))
       end do
    end do

    call device_finalize

  end subroutine test_dofmap_face14

  !> Gather-scatter on two ranks that share no dofs
  !! @details Each rank holds one element and the two elements are apart, so
  !! neither rank shares a dof with the other. Both still run the shared
  !! gather and scatter, which were handed block arrays only allocated when
  !! a rank had shared dofs.
  @test(npes=[2])
  subroutine test_gs_no_shared_dofs(this)
    class(test_gather_scatter), intent(inout) :: this
    type(linear_dist_t) :: dist

    dist = linear_dist_t(2, this%getProcessRank(), &
         this%getNumProcesses(), NEKO_COMM)
    call check_gs_isolated_elements(dist)

  end subroutine test_gs_no_shared_dofs

  !> Gather-scatter on two ranks, one of which holds no elements
  !! @details The rank holding the element shares no dofs, as in
  !! test_gs_no_shared_dofs, and the other rank has no dofs at all.
  @test(npes=[2])
  subroutine test_gs_empty_rank(this)
    class(test_gather_scatter), intent(inout) :: this
    type(linear_dist_t) :: dist

    dist = linear_dist_t(1, this%getProcessRank(), &
         this%getNumProcesses(), NEKO_COMM)
    call check_gs_isolated_elements(dist)

  end subroutine test_gs_empty_rank

  !> Check that each gather-scatter operation leaves a field unchanged on
  !! elements that share no points
  !! @details Every rank adds at most one element, the unit cube moved along
  !! x by twice the rank, with point ids of its own.
  !! @param dist Distribution of the elements, at most one per rank
  subroutine check_gs_isolated_elements(dist)
    type(linear_dist_t), intent(in) :: dist
    integer, parameter :: gdim = 3, lx = 4
    integer, parameter :: ops(4) = [GS_OP_ADD, GS_OP_MUL, GS_OP_MIN, &
         GS_OP_MAX]
    type(mesh_t) :: m
    type(space_t) :: Xh
    type(dofmap_t) :: d
    type(gs_t) :: gs_h
    type(field_t) :: x
    type(point_t) :: p(8)
    real(kind=rp), allocatable :: x0(:)
    integer :: i, k, n

    call device_init

    call m%init(gdim, dist)
    if (m%nelv .eq. 1) then
       do i = 1, 8
          call p(i)%init(real(mod(i - 1, 2) + 2 * pe_rank, dp), &
               real(mod((i - 1) / 2, 2), dp), real((i - 1) / 4, dp), &
               8 * pe_rank + i)
       end do
       call m%add_element(1, m%offset_el + 1, p(1), p(2), p(3), p(4), &
            p(5), p(6), p(7), p(8))
    end if
    call m%generate_conn()

    call Xh%init(GLL, lx, lx, lx)
    call d%init(m, Xh)
    call gs_h%init(d)
    call x%init(m, Xh, "x")
    n = Xh%lx * Xh%ly * Xh%lz * m%nelv

    allocate(x0(n))
    do i = 1, n
       x0(i) = real(i, rp)
    end do

    do k = 1, size(ops)
       call copy(x%x, x0, n)
       if (NEKO_BCKND_DEVICE .eq. 1) then
          call device_memcpy(x%x, x%x_d, n, HOST_TO_DEVICE, sync = .false.)
       end if

       call gs_h%op(x%x, n, ops(k))

       if (NEKO_BCKND_DEVICE .eq. 1) then
          call device_memcpy(x%x, x%x_d, n, DEVICE_TO_HOST, sync = .true.)
       end if

       if (n .gt. 0) then
          @assertEqual(x0, reshape(x%x, [n]), tolerance = 0.0_rp)
       end if
    end do

    deallocate(x0)
    call x%free()
    call gs_h%free()
    call d%free()
    call Xh%free()
    call m%free()

    call device_finalize

  end subroutine check_gs_isolated_elements

end module test_gather_scatter_parallel
