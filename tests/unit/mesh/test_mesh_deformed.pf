!> Tests of the deformed-element flags of a mesh.
!! The flag decides whether the cross terms G12, G13 and G23 of the metric
!! are applied, so an element must be flagged whenever one of them is
!! non-zero. For a trilinear element that is whenever it is not a
!! rectangular box. An element recorded with curved edges must be flagged
!! whatever its vertices are. The meshes are finalized, so their flags are
!! set as for a mesh read from file.
module test_mesh_deformed
  use pfunit
  use num_types, only : dp
  use mesh, only : mesh_t
  use point, only : point_t
  use pfunit_comm_utils, only : comm_init_test, comm_free_test
  implicit none

  @TestCase
  type, extends(MPITestCase) :: test_mesh_deformed_case
   contains
     procedure :: setUp
     procedure :: tearDown
  end type test_mesh_deformed_case

contains

  subroutine setUp(this)
    class(test_mesh_deformed_case), intent(inout) :: this
    call comm_init_test(this%getMpiCommunicator())
  end subroutine setUp

  subroutine tearDown(this)
    class(test_mesh_deformed_case), intent(inout) :: this
    call comm_free_test()
  end subroutine tearDown

  !> Boxes aligned with the axes have no cross terms and are not deformed.
  @test(npes=[1])
  subroutine test_mesh_box_not_deformed(this)
    class(test_mesh_deformed_case), intent(inout) :: this
    type(mesh_t) :: msh
    real(kind=dp) :: x(3, 8)
    logical :: flags(2)

    call box_vertices(x, [0.0_dp, 0.0_dp, 0.0_dp], [1.0_dp, 1.0_dp, 1.0_dp])
    call single_hex_mesh(msh, x)
    flags(1) = msh%dfrmd_el(1)
    call msh%free()

    call box_vertices(x, [1.5_dp, -2.0_dp, 0.25_dp], &
         [2.0_dp, 0.5_dp, 4.0_dp])
    call single_hex_mesh(msh, x)
    flags(2) = msh%dfrmd_el(1)
    call msh%free()

    @assertFalse(flags(1), message = 'Unit cube flagged as deformed')
    @assertFalse(flags(2), message = 'Stretched box flagged as deformed')
  end subroutine test_mesh_box_not_deformed

  !> A unit cube sheared in each of the six ways one coordinate can be
  !! shifted in proportion to another. Each shear makes one cross term
  !! non-zero; those in the y-z plane make G23 the only one.
  @test(npes=[1])
  subroutine test_mesh_sheared_deformed(this)
    class(test_mesh_deformed_case), intent(inout) :: this
    ! Coordinate shifted, and the coordinate it is shifted in proportion to
    integer, parameter :: shifted(6) = [1, 1, 2, 2, 3, 3]
    integer, parameter :: by(6) = [2, 3, 1, 3, 1, 2]
    type(mesh_t) :: msh
    real(kind=dp) :: x(3, 8)
    logical :: flags(6)
    character(len=80) :: msg
    integer :: i

    do i = 1, 6
       call box_vertices(x, [0.0_dp, 0.0_dp, 0.0_dp], &
            [1.0_dp, 1.0_dp, 1.0_dp])
       x(shifted(i), :) = x(shifted(i), :) + 0.5_dp * x(by(i), :)
       call single_hex_mesh(msh, x)
       flags(i) = msh%dfrmd_el(1)
       call msh%free()
    end do

    write(msg, '(A, 6L2)') 'Flags for x(y), x(z), y(x), y(z), z(x), z(y):', &
         flags
    @assertTrue(all(flags), message = trim(msg))
  end subroutine test_mesh_sheared_deformed

  !> A unit cube with one of the vertices 2 to 7 moved so that its edge to
  !! vertex 1 or 8 is half as long again. The edges at vertices 1 and 8 stay
  !! mutually orthogonal, but the element is no longer a parallelepiped, so
  !! the cross terms of its metric vary and are not all zero.
  @test(npes=[1])
  subroutine test_mesh_corner_deformed(this)
    class(test_mesh_deformed_case), intent(inout) :: this
    ! Vertex moved, the axis of its edge to vertex 1 or 8, and its new
    ! coordinate along that axis
    integer, parameter :: vertex(6) = [2, 3, 5, 4, 6, 7]
    integer, parameter :: axis(6) = [1, 2, 3, 3, 2, 1]
    real(kind=dp), parameter :: coord(6) = [1.5_dp, 1.5_dp, 1.5_dp, &
         -0.5_dp, -0.5_dp, -0.5_dp]
    type(mesh_t) :: msh
    real(kind=dp) :: x(3, 8)
    logical :: flags(6)
    character(len=80) :: msg
    integer :: i

    do i = 1, 6
       call box_vertices(x, [0.0_dp, 0.0_dp, 0.0_dp], &
            [1.0_dp, 1.0_dp, 1.0_dp])
       x(axis(i), vertex(i)) = coord(i)
       call single_hex_mesh(msh, x)
       flags(i) = msh%dfrmd_el(1)
       call msh%free()
    end do

    write(msg, '(A, 6L2)') 'Flags for vertices 2, 3, 5, 4, 6, 7 moved:', flags
    @assertTrue(all(flags), message = trim(msg))
  end subroutine test_mesh_corner_deformed

  !> Two unit cubes side by side, the second recorded with a curved edge,
  !! as an arc and as a midpoint, the two curve types the dofmap applies.
  !! Only the curved element is deformed.
  @test(npes=[1])
  subroutine test_mesh_curved_deformed(this)
    class(test_mesh_deformed_case), intent(inout) :: this
    type(mesh_t) :: msh
    logical :: flags(2)
    integer :: ncurved, curve_type

    do curve_type = 3, 4
       call curved_pair_mesh(msh, curve_type)
       ncurved = msh%curve%size
       flags = msh%dfrmd_el(1:2)
       call msh%free()

       @assertEqual(1, ncurved, message = 'Curved element not recorded')
       @assertFalse(flags(1), message = 'Straight element flagged')
       @assertTrue(flags(2), message = 'Curved element not flagged')
    end do
  end subroutine test_mesh_curved_deformed

  !> Vertices of a box, in the NEKTON symmetric ordering of
  !! src/mesh/hex.f90, i.e. x fastest, then y, then z.
  !! @param x Coordinates of the vertices.
  !! @param x0 Coordinates of the corner with the smallest coordinates.
  !! @param h Side lengths of the box.
  subroutine box_vertices(x, x0, h)
    real(kind=dp), intent(out) :: x(3, 8)
    real(kind=dp), intent(in) :: x0(3), h(3)
    integer :: l

    do l = 1, 8
       x(:, l) = x0 + h * [mod(l - 1, 2), mod((l - 1) / 2, 2), (l - 1) / 4]
    end do
  end subroutine box_vertices

  !> Single hex with the vertices @a x, finalized.
  !! @param msh Mesh to create.
  !! @param x Coordinates of the vertices, in the NEKTON symmetric ordering.
  subroutine single_hex_mesh(msh, x)
    type(mesh_t), intent(inout) :: msh
    real(kind=dp), intent(in) :: x(3, 8)
    type(point_t) :: p(8)
    integer :: l

    do l = 1, 8
       call p(l)%init(x(:, l), l)
    end do

    call msh%init(3, 1)
    call msh%add_element(1, 1, p(1), p(2), p(3), p(4), &
         p(5), p(6), p(7), p(8))
    call msh%finalize()
  end subroutine single_hex_mesh

  !> Two unit cubes on [0, 2] x [0, 1] x [0, 1], the second recorded as
  !! curved before the mesh is finalized, as the mesh readers do.
  !!
  !!   z = 0:   p4 ---- p5 ---- p6     z = 1:  p10 --- p11 --- p12
  !!             |  e1  |  e2  |                |  e1  |  e2  |
  !!             |      |      |                |      |      |
  !!            p1 ---- p2 ---- p3               p7 ---- p8 ---- p9
  !!
  !! @param msh Mesh to create.
  !! @param curve_type Type of the curved edge, 3 for an arc and 4 for a
  !! midpoint.
  subroutine curved_pair_mesh(msh, curve_type)
    type(mesh_t), intent(inout) :: msh
    integer, intent(in) :: curve_type
    type(point_t) :: p(12)
    real(kind=dp) :: curve_data(5, 12)
    integer :: curve_types(12)
    integer :: i, j, k, id

    do k = 0, 1
       do j = 0, 1
          do i = 0, 2
             id = 1 + i + 3 * (j + 2 * k)
             call p(id)%init(real(i, dp), real(j, dp), real(k, dp), id)
          end do
       end do
    end do

    call msh%init(3, 2)
    call msh%add_element(1, 1, p(1), p(2), p(4), p(5), &
         p(7), p(8), p(10), p(11))
    call msh%add_element(2, 2, p(2), p(3), p(5), p(6), &
         p(8), p(9), p(11), p(12))

    ! Curve the first edge of element 2, from p2 to p3, as an arc of radius
    ! 2 or through a midpoint bulging out of the element
    curve_data = 0.0_dp
    curve_types = 0
    curve_types(1) = curve_type
    if (curve_type .eq. 3) then
       curve_data(1, 1) = 2.0_dp
    else
       curve_data(1:3, 1) = [1.5_dp, -0.1_dp, 0.0_dp]
    end if
    call msh%mark_curve_element(2, curve_data, curve_types)
    call msh%finalize()
  end subroutine curved_pair_mesh

end module test_mesh_deformed
