USEMPI=YES
ifneq ("$(wildcard @PFUNIT_DIR@/include/PFUNIT.mk)", "")
include @PFUNIT_DIR@/include/PFUNIT.mk
endif
FFLAGS += $(PFUNIT_EXTRA_FFLAGS) @NEKO_PKG_FCFLAGS@ -I@top_builddir@/src
FC = @FC@

# Look for the sources in the source directory, as an out-of-tree
# build has none of them in the build directory.
srcdir = @srcdir@
VPATH = @srcdir@

# Depend on the library so the test objects follow any change to Neko.
NEKO_LIB := $(wildcard @top_builddir@/src/libneko.la)

%.o : %.F90 $(NEKO_LIB)
	$(FC) -c $(FFLAGS) $<

# The fixtures are compiled here, not in ../fixtures, so that their module
# files end up in this directory whatever other suite has compiled them before.
mesh_fixture.o : ../fixtures/mesh_fixture.f90 $(NEKO_LIB)
	$(FC) -c $(FFLAGS) -o $@ $<
error_redirection.o : ../fixtures/error_redirection.f90 $(NEKO_LIB)
	$(FC) -c $(FFLAGS) -o $@ $<


check: filter_suite

# Regenerate this Makefile from Makefile.in via config.status
# whenever it changes.
SUBDIR := $(patsubst $(abspath @top_builddir@)/%,%,$(CURDIR))

Makefile: $(srcdir)/Makefile.in @top_builddir@/config.status
	cd @top_builddir@ && $(SHELL) ./config.status $(SUBDIR)/Makefile


filter_suite_TESTS := test_pde_filter.pf
filter_suite_OTHER_SOURCES = mesh_fixture.f90 error_redirection.f90
filter_suite_OTHER_LIBRARIES = -L@top_builddir@/src/.libs -lneko @LDFLAGS@ @LIBS@
$(eval $(call make_pfunit_test,filter_suite))
filter_suite.inc: Makefile
test_pde_filter.o: mesh_fixture.o error_redirection.o

distclean:
clean:
	$(RM) *.o *.mod *.a *.inc *.F90 filter_suite



all:
html:
install:
distdir:
