!> Tests of the step mapping and of the Brinkman boundary-mesh step transform.
module test_mappings
  use pfunit
  use num_types, only : rp, dp
  use comm, only : NEKO_COMM, pe_rank, pe_size
  use pfunit_comm_utils, only : comm_init_test, comm_free_test
  use device, only : device_init, device_finalize, device_memcpy, &
       DEVICE_TO_HOST
  use neko_config, only : NEKO_BCKND_DEVICE
  use neko_mpi_types, only : neko_mpi_types_init, neko_mpi_types_free
  use utils, only : throw_warning, default_throw_warning
  use mesh_fixture, only : single_unit_hex_mesh
  use mesh, only : mesh_t
  use space, only : space_t, GLL
  use dofmap, only : dofmap_t
  use field, only : field_t
  use point, only : point_t
  use tri_mesh, only : tri_mesh_t
  use mappings_cpu, only : step_function_cpu
  use mappings, only : step_function_field
  use signed_distance, only : signed_distance_field
  implicit none

  @TestCase
  type, extends(MPITestCase) :: test_mappings_case
   contains
     procedure :: setUp
     procedure :: tearDown
  end type test_mappings_case

contains

  subroutine setUp(this)
    class(test_mappings_case), intent(inout) :: this
    call comm_init_test(this%getMpiCommunicator())
    if (NEKO_BCKND_DEVICE .eq. 1) call device_init
    call neko_mpi_types_init()
    throw_warning => default_throw_warning
  end subroutine setUp

  subroutine tearDown(this)
    class(test_mappings_case), intent(inout) :: this
    if (NEKO_BCKND_DEVICE .eq. 1) call device_finalize
    call neko_mpi_types_free()
    call comm_free_test()
  end subroutine tearDown

  !> mappings.f90 documents value0 before the step and value1 after it,
  !! which is what the CUDA, HIP, OpenCL and Metal kernels compute.
  @test(npes=[1])
  subroutine test_step_function_cpu_sides(this)
    class(test_mappings_case), intent(inout) :: this
    real(kind=rp) :: x(5)

    x = [-1.0_rp, 0.0_rp, 0.05_rp, 0.1_rp, 0.2_rp]
    call step_function_cpu(x, 0.1_rp, 1.0_rp, 0.0_rp, 5)
    @assertEqual([1.0_rp, 1.0_rp, 1.0_rp, 0.0_rp, 0.0_rp], x)
  end subroutine test_step_function_cpu_sides

  !> Add a triangle wound so that its normal points away from `c`.
  subroutine add_outward(msh, a, b, d, c, id)
    type(tri_mesh_t), intent(inout) :: msh
    real(kind=dp), intent(in) :: a(3), b(3), d(3), c(3)
    integer, intent(inout) :: id
    type(point_t) :: p1, p2, p3
    real(kind=dp) :: n(3)

    n(1) = (b(2) - a(2)) * (d(3) - a(3)) - (b(3) - a(3)) * (d(2) - a(2))
    n(2) = (b(3) - a(3)) * (d(1) - a(1)) - (b(1) - a(1)) * (d(3) - a(3))
    n(3) = (b(1) - a(1)) * (d(2) - a(2)) - (b(2) - a(2)) * (d(1) - a(1))
    call p1%init(a, id + 1)
    if (dot_product(n, (a + b + d) / 3.0_dp - c) .gt. 0.0_dp) then
       call p2%init(b, id + 2)
       call p3%init(d, id + 3)
    else
       call p2%init(d, id + 2)
       call p3%init(b, id + 3)
    end if
    id = id + 3
    call msh%add_element(p1, p2, p3)
  end subroutine add_outward

  !> The Brinkman boundary_mesh `step` transform as brinkman_source_term
  !! applies it: signed distance with the search radius equal to `value`,
  !! then step_function_field(value, 1, 0). A closed octahedron of
  !! half-diagonal 0.3 centred in the unit hex must be solid at the centre
  !! and fluid at a corner of the hex, which is about 0.69 away from it.
  @test(npes=[1])
  subroutine test_brinkman_step_transform(this)
    class(test_mappings_case), intent(inout) :: this
    type(mesh_t) :: msh
    type(space_t) :: Xh
    type(dofmap_t) :: dof
    type(field_t) :: f
    type(tri_mesh_t) :: octa
    real(kind=dp) :: c(3), v(3, 6)
    real(kind=dp), parameter :: value = 0.1_dp
    integer :: i, j, k, id
    integer, parameter :: faces(3, 8) = reshape([1, 3, 5, 3, 2, 5, &
         2, 4, 5, 4, 1, 5, 3, 1, 6, 2, 3, 6, 4, 2, 6, 1, 4, 6], [3, 8])

    call single_unit_hex_mesh(msh)
    call Xh%init(GLL, 5, 5, 5)
    call dof%init(msh, Xh)
    call f%init(dof, 'indicator')

    c = 0.5_dp
    v = 0.0_dp
    do i = 1, 3
       v(:, 2 * i - 1) = c
       v(:, 2 * i) = c
       v(i, 2 * i - 1) = c(i) + 0.3_dp
       v(i, 2 * i) = c(i) - 0.3_dp
    end do
    call octa%init(8)
    id = 0
    do k = 1, 8
       call add_outward(octa, v(:, faces(1, k)), v(:, faces(2, k)), &
            v(:, faces(3, k)), c, id)
    end do

    call signed_distance_field(f, octa, value)
    call step_function_field(f, real(value, rp), 1.0_rp, 0.0_rp)
    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_memcpy(f%x, f%x_d, f%size(), DEVICE_TO_HOST, sync = .true.)
    end if

    ! GLL node (3,3,3) of a 5-point rule is the element centre.
    @assertEqual(1.0_rp, f%x(3, 3, 3, 1), message = 'centre must be solid')
    @assertEqual(0.0_rp, f%x(1, 1, 1, 1), message = 'corner must be fluid')

    call f%free()
    call octa%free()
    call dof%free()
    call Xh%free()
    call msh%free()
  end subroutine test_brinkman_step_transform

end module test_mappings
