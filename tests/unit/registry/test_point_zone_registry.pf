!> Tests of the point zone registry.
module test_point_zone_registry
  use pfunit
  use mesh, only : mesh_t
  use mesh_fixture, only : single_unit_hex_mesh
  use comm, only : pe_rank, pe_size
  use json_module, only : json_file
  use point_zone, only : point_zone_t
  use point_zone_registry, only : neko_point_zone_registry
  implicit none

contains

  !> The single unit hexahedron [0, 1]^3, on one rank.
  subroutine unit_hex_mesh(msh)
    type(mesh_t), intent(inout) :: msh

    pe_rank = 0
    pe_size = 1
    call single_unit_hex_mesh(msh)
  end subroutine unit_hex_mesh

  !> A combine zone listing several registry zones by name must use each of
  !! them, not the first one repeatedly.
  @test
  subroutine test_combine_named_zones()
    type(mesh_t) :: msh
    type(json_file) :: json
    class(point_zone_t), pointer :: pz

    call unit_hex_mesh(msh)

    ! With polynomial order 4 the GLL points along x are 0, 0.173, 0.5,
    ! 0.827 and 1, so each box holds two of the five x-planes, 50 points.
    call json%load_from_string( &
         '{"case": {"numerics": {"polynomial_order": 4},' // &
         '"point_zones": [' // &
         '{"name": "left", "geometry": "box", "x_bounds": [-0.1, 0.3],' // &
         '"y_bounds": [-0.1, 1.1], "z_bounds": [-0.1, 1.1]},' // &
         '{"name": "right", "geometry": "box", "x_bounds": [0.7, 1.1],' // &
         '"y_bounds": [-0.1, 1.1], "z_bounds": [-0.1, 1.1]},' // &
         '{"name": "both", "geometry": "combine", "operator": "OR",' // &
         '"subsets": [{"name": "left"}, {"name": "right"}]}]}}')

    call neko_point_zone_registry%init(json, msh)

    pz => neko_point_zone_registry%get_point_zone("left")
    @assertEqual(50, pz%size)
    pz => neko_point_zone_registry%get_point_zone("right")
    @assertEqual(50, pz%size)
    pz => neko_point_zone_registry%get_point_zone("both")
    @assertEqual(100, pz%size)

    call neko_point_zone_registry%free()
    call json%destroy()
    call msh%free()
  end subroutine test_combine_named_zones

  !> A combine zone mixing named and inline subsets must pair each named
  !! subset with its own registry zone, whatever the order of the subsets.
  @test
  subroutine test_combine_interleaved_zones()
    type(mesh_t) :: msh
    type(json_file) :: json
    class(point_zone_t), pointer :: pz
    integer, pointer :: idx(:)
    integer :: i, ix, iy

    call unit_hex_mesh(msh)

    ! With polynomial order 4 the GLL points along each axis are 0, 0.173,
    ! 0.5, 0.827 and 1. "left" holds the x-planes 1 to 3, "right" the
    ! x-planes 3 to 5 and the inline box the y-planes 1 to 3, so their
    ! intersection is x-plane 3 with y-planes 1 to 3, 15 points. Resolving
    ! both names to "left" gives x-planes 1 to 3 instead, 45 points.
    call json%load_from_string( &
         '{"case": {"numerics": {"polynomial_order": 4},' // &
         '"point_zones": [' // &
         '{"name": "left", "geometry": "box", "x_bounds": [-0.1, 0.6],' // &
         '"y_bounds": [-0.1, 1.1], "z_bounds": [-0.1, 1.1]},' // &
         '{"name": "right", "geometry": "box", "x_bounds": [0.4, 1.1],' // &
         '"y_bounds": [-0.1, 1.1], "z_bounds": [-0.1, 1.1]},' // &
         '{"name": "middle", "geometry": "combine", "operator": "AND",' // &
         '"subsets": [{"name": "left"},' // &
         '{"name": "lower", "geometry": "box",' // &
         '"x_bounds": [-0.1, 1.1], "y_bounds": [-0.1, 0.6],' // &
         '"z_bounds": [-0.1, 1.1]},' // &
         '{"name": "right"}]}]}}')

    call neko_point_zone_registry%init(json, msh)

    pz => neko_point_zone_registry%get_point_zone("middle")
    @assertEqual(15, pz%size)

    ! On the single element the linear index is
    ! ix + 5 (iy - 1) + 25 (iz - 1).
    idx => pz%mask%get()
    do i = 1, pz%size
       ix = mod(idx(i) - 1, 5) + 1
       iy = mod((idx(i) - 1) / 5, 5) + 1
       @assertEqual(3, ix)
       @assertTrue(iy .le. 3)
    end do

    call neko_point_zone_registry%free()
    call json%destroy()
    call msh%free()
  end subroutine test_combine_interleaved_zones

end module test_point_zone_registry
