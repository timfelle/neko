! Tests how the Brinkman source term filters its objects: an object with a
! `filter` of its own is filtered with that filter alone, and the objects
! without one are combined and filtered with the top-level `filter`.
!
! The source term is set up from JSON, as a case file does, on two unit hex
! elements side by side along x, so x is in [0, 2]. It has two objects of
! type field: object A is 1 for x < 0.5 and object B is 1 for x > 1.5, and
! both are 0 elsewhere. Each test builds the expected indicator from the same
! objects, combining them by a point-wise max and filtering them with PDE
! filters of its own.
!
! A PDE filter takes its Jacobi preconditioner from the state of the SEM
! coefficients when it is set up, and applying a PDE filter changes that
! state. The source term sets up all its filters before applying any, so the
! tests set up their own filters before the source term. Then every filter
! starts from the same state, the filter solves are the same, and the
! indicators agree to the last bit.
module test_brinkman
  use mpi
  use pfunit
  use num_types, only : rp
  use pfunit_comm_utils, only : comm_init_test, comm_free_test
  use device, only : device_init, device_finalize, HOST_TO_DEVICE, &
       DEVICE_TO_HOST
  use neko_config, only : NEKO_BCKND_DEVICE
  use neko_mpi_types, only : neko_mpi_types_init, neko_mpi_types_free
  use mesh_fixture, only : two_adjacent_unit_hex_mesh
  use error_redirection, only : redirect_errors, restore_errors
  use mesh, only : mesh_t
  use space, only : space_t, GLL
  use dofmap, only : dofmap_t
  use gather_scatter, only : gs_t
  use coefs, only : coef_t
  use field, only : field_t
  use field_list, only : field_list_t
  use filter, only : filter_t
  use PDE_filter, only : PDE_filter_t
  use mappings, only : permeability_field
  use registry, only : neko_registry
  use scratch_registry, only : neko_scratch_registry
  use brinkman_source_term, only : brinkman_source_term_t
  use json_module, only : json_file
  implicit none

  !> Number of GLL points in each direction of an element.
  integer, parameter :: LX = 6

  !> A PDE filter, used both in the source term and by the tests.
  character(len=*), parameter :: pde_filter_json = &
       '{"type": "PDE", "radius": 0.5}'

  !> The mesh.
  type(mesh_t), target :: msh
  !> The function space.
  type(space_t), target :: Xh
  !> The dofmap.
  type(dofmap_t), target :: dof
  !> The gather-scatter handle.
  type(gs_t), target :: gs
  !> The SEM coefficients.
  type(coef_t), target :: coef
  !> The fields the source term is added to.
  type(field_t), target :: fu, fv, fw
  !> The list of fu, fv and fw.
  type(field_list_t), target :: rhs
  !> The values of object A and object B.
  real(kind=rp), allocatable :: a(:,:,:,:), b(:,:,:,:)

  @TestCase
  type, extends(MPITestCase) :: test_brinkman_case
   contains
     procedure :: setUp
     procedure :: tearDown
  end type test_brinkman_case

contains

  subroutine setUp(this)
    class(test_brinkman_case), intent(inout) :: this

    call comm_init_test(this%getMpiCommunicator())
    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_init
    end if
    call neko_mpi_types_init()
    ! An error raised by the source term becomes a pFUnit exception, which
    ! fails the test unless the test expects it, in place of stopping the
    ! suite.
    call redirect_errors()

    call two_adjacent_unit_hex_mesh(msh)
    call Xh%init(GLL, LX, LX, LX)
    call dof%init(msh, Xh)
    call gs%init(dof)
    call coef%init(gs)
    call neko_registry%init()
    call neko_scratch_registry%init(dof = dof)

    call fu%init(dof, 'fu')
    call fv%init(dof, 'fv')
    call fw%init(dof, 'fw')
    call rhs%init(3)
    call rhs%assign_to_field(1, fu)
    call rhs%assign_to_field(2, fv)
    call rhs%assign_to_field(3, fw)

    a = merge(1.0_rp, 0.0_rp, dof%x%x .lt. 0.5_rp)
    b = merge(1.0_rp, 0.0_rp, dof%x%x .gt. 1.5_rp)
    call add_object_field('brinkman_test_a', a)
    call add_object_field('brinkman_test_b', b)
  end subroutine setUp

  subroutine tearDown(this)
    class(test_brinkman_case), intent(inout) :: this

    deallocate(a, b)
    call rhs%free()
    call fu%free()
    call fv%free()
    call fw%free()
    call neko_scratch_registry%free()
    call neko_registry%free()
    call coef%free()
    call gs%free()
    call dof%free()
    call Xh%free()
    call msh%free()

    call restore_errors()
    if (NEKO_BCKND_DEVICE .eq. 1) then
       call device_finalize
    end if
    call neko_mpi_types_free()
    call comm_free_test()
  end subroutine tearDown

  !> Register a field for an object of type field.
  !! @param name The name of the field.
  !! @param x The values of the field.
  subroutine add_object_field(name, x)
    character(len=*), intent(in) :: name
    real(kind=rp), intent(in) :: x(:,:,:,:)
    type(field_t), pointer :: f

    call neko_registry%add_field(dof, name)
    f => neko_registry%get_field(name)
    f%x = x
    call f%copy_from(HOST_TO_DEVICE, sync = .true.)
  end subroutine add_object_field

  !> The JSON object of a Brinkman source term with the objects A and B.
  !! @param a_filter The `filter` object of object A, none if absent.
  !! @param top_filter The top-level `filter` object, none if absent.
  !! @return The JSON object.
  function brinkman_json(a_filter, top_filter) result(str)
    character(len=*), intent(in), optional :: a_filter, top_filter
    character(len=:), allocatable :: str

    str = '{"type": "brinkman", "limits": [0.0, 100.0], "penalty": 1.0, ' // &
         '"objects": [{"type": "field", "name": "brinkman_test_a"'
    if (present(a_filter)) str = str // ', "filter": ' // a_filter
    str = str // '}, {"type": "field", "name": "brinkman_test_b"}]'
    if (present(top_filter)) str = str // ', "filter": ' // top_filter
    str = str // '}'
  end function brinkman_json

  !> Set up a Brinkman source term from JSON.
  !! @param brinkman The source term.
  !! @param str The JSON object of the source term.
  subroutine init_brinkman(brinkman, str)
    type(brinkman_source_term_t), intent(inout) :: brinkman
    character(len=*), intent(in) :: str
    type(json_file) :: json

    call json%initialize()
    call json%load_from_string(str)
    call brinkman%init(json, rhs, coef, 'fluid')
    call json%destroy()
  end subroutine init_brinkman

  !> Set up a PDE filter from pde_filter_json.
  !! @param pde_filter The filter.
  subroutine init_pde_filter(pde_filter)
    type(PDE_filter_t), intent(inout) :: pde_filter
    type(json_file) :: json

    call json%initialize()
    call json%load_from_string(pde_filter_json)
    call pde_filter%init(json, coef)
    call json%destroy()
  end subroutine init_pde_filter

  !> Apply a filter to the values @a x.
  !! @param flt The filter.
  !! @param x The values to filter.
  !! @return The filtered values.
  function filtered(flt, x) result(y)
    class(filter_t), intent(inout) :: flt
    real(kind=rp), intent(in) :: x(:,:,:,:)
    real(kind=rp), allocatable :: y(:,:,:,:)
    type(field_t) :: f_in, f_out

    call f_in%init(dof, 'f_in')
    call f_out%init(dof, 'f_out')
    f_in%x = x
    call f_in%copy_from(HOST_TO_DEVICE, sync = .true.)
    call flt%apply(f_out, f_in)
    call f_out%copy_from(DEVICE_TO_HOST, sync = .true.)
    y = f_out%x
    call f_in%free()
    call f_out%free()
  end function filtered

  !> The values of a field in the registry.
  !! @param name The name of the field.
  !! @return The values of the field.
  function registry_values(name) result(x)
    character(len=*), intent(in) :: name
    real(kind=rp), allocatable :: x(:,:,:,:)
    type(field_t), pointer :: f

    f => neko_registry%get_field(name)
    call f%copy_from(DEVICE_TO_HOST, sync = .true.)
    x = f%x
  end function registry_values

  !> The permeability for the indicator values @a x, as the source term
  !! computes it for its limits [0, 100] and penalty 1.
  !! @param x The indicator values.
  !! @return The permeability values.
  function permeability(x) result(y)
    real(kind=rp), intent(in) :: x(:,:,:,:)
    real(kind=rp), allocatable :: y(:,:,:,:)
    type(field_t) :: f

    call f%init(dof, 'f')
    f%x = x
    call f%copy_from(HOST_TO_DEVICE, sync = .true.)
    call permeability_field(f, 0.0_rp, 100.0_rp, 1.0_rp)
    call f%copy_from(DEVICE_TO_HOST, sync = .true.)
    y = f%x
    call f%free()
  end function permeability

  !> Verify that without any filter the indicator is the point-wise max of
  !! the objects, and that no unfiltered indicator is registered.
  @test(npes=[1])
  subroutine test_no_filter_combines_by_max(this)
    class(test_brinkman_case), intent(inout) :: this
    type(brinkman_source_term_t) :: brinkman
    real(kind=rp) :: err

    call init_brinkman(brinkman, brinkman_json())

    err = maxval(abs(registry_values('brinkman_indicator') - max(a, b)))
    @assertEqual(0.0_rp, err)
    @assertFalse(neko_registry%field_exists('brinkman_unfiltered'))

    call brinkman%free()
  end subroutine test_no_filter_combines_by_max

  !> Verify that with only a top-level filter the objects are combined first
  !! and the combination is filtered once, and that the unfiltered indicator
  !! is the combination.
  @test(npes=[1])
  subroutine test_top_level_filter_only(this)
    class(test_brinkman_case), intent(inout) :: this
    type(brinkman_source_term_t) :: brinkman
    type(PDE_filter_t) :: top_filter
    real(kind=rp), allocatable :: expected(:,:,:,:)
    real(kind=rp) :: err

    call init_pde_filter(top_filter)
    call init_brinkman(brinkman, brinkman_json(top_filter = pde_filter_json))
    expected = filtered(top_filter, max(a, b))

    err = maxval(abs(registry_values('brinkman_indicator') - expected))
    @assertEqual(0.0_rp, err)
    @assertTrue(neko_registry%field_exists('brinkman_unfiltered'))
    err = maxval(abs(registry_values('brinkman_unfiltered') - max(a, b)))
    @assertEqual(0.0_rp, err)

    call top_filter%free()
    call brinkman%free()
  end subroutine test_top_level_filter_only

  !> Verify that an object filter of type none keeps the object out of the
  !! top-level filter: object A stays unfiltered, at 1 in all its region,
  !! while object B is filtered by the top-level filter alone.
  @test(npes=[1])
  subroutine test_object_none_overrides_top_level(this)
    class(test_brinkman_case), intent(inout) :: this
    type(brinkman_source_term_t) :: brinkman
    type(PDE_filter_t) :: top_filter
    real(kind=rp), allocatable :: indicator(:,:,:,:), expected(:,:,:,:)
    real(kind=rp) :: err

    call init_pde_filter(top_filter)
    call init_brinkman(brinkman, brinkman_json(a_filter = '{"type": "none"}', &
         top_filter = pde_filter_json))
    indicator = registry_values('brinkman_indicator')
    expected = max(filtered(top_filter, b), a)

    @assertEqual(1.0_rp, minval(indicator, mask = a .gt. 0.5_rp))
    err = maxval(abs(indicator - expected))
    @assertEqual(0.0_rp, err)
    @assertTrue(neko_registry%field_exists('brinkman_unfiltered'))
    err = maxval(abs(registry_values('brinkman_unfiltered') - max(a, b)))
    @assertEqual(0.0_rp, err)

    call top_filter%free()
    call brinkman%free()
  end subroutine test_object_none_overrides_top_level

  !> Verify that a PDE filter of an object filters that object alone when
  !! there is no top-level filter, that the unfiltered indicator holds both
  !! objects unfiltered, and that the permeability follows the indicator.
  @test(npes=[1])
  subroutine test_object_pde_filter_alone(this)
    class(test_brinkman_case), intent(inout) :: this
    type(brinkman_source_term_t) :: brinkman
    type(PDE_filter_t) :: a_filter
    real(kind=rp), allocatable :: expected(:,:,:,:)
    real(kind=rp) :: err

    call init_pde_filter(a_filter)
    call init_brinkman(brinkman, brinkman_json(a_filter = pde_filter_json))
    expected = max(filtered(a_filter, a), b)

    err = maxval(abs(registry_values('brinkman_indicator') - expected))
    @assertEqual(0.0_rp, err)
    @assertTrue(neko_registry%field_exists('brinkman_unfiltered'))
    err = maxval(abs(registry_values('brinkman_unfiltered') - max(a, b)))
    @assertEqual(0.0_rp, err)
    err = maxval(abs(registry_values('brinkman_permeability') - &
         permeability(expected)))
    @assertEqual(0.0_rp, err)

    call a_filter%free()
    call brinkman%free()
  end subroutine test_object_pde_filter_alone

  !> Verify that an object filter of an unknown type is an error, as it is
  !! for the top-level filter.
  @test(npes=[1])
  subroutine test_unknown_object_filter_raises(this)
    class(test_brinkman_case), intent(inout) :: this
    type(brinkman_source_term_t) :: brinkman

    call init_brinkman(brinkman, brinkman_json(a_filter = '{"type": "box"}'))
    @assertExceptionRaised()

    call brinkman%free()
  end subroutine test_unknown_object_filter_raises

end module test_brinkman
