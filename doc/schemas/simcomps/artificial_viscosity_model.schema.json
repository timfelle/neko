{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:neko:schema:simcomps:artificial_viscosity_model",
  "$defs": {
    "simulationComponent": {
      "allOf": [
        {
          "$ref": "urn:neko:schema:simulation-components#/$defs/simcompBase"
        },
        {
          "$ref": "urn:neko:schema:simulation-components#/$defs/simcompFieldWriterOptions"
        },
        {
          "$ref": "urn:neko:schema:simulation-components#/$defs/simcompFieldWriterPointZone"
        },
        {
          "type": "object",
          "required": [
            "model"
          ],
          "properties": {
            "type": {
              "const": "artificial_viscosity_model"
            },
            "field_name": {
              "$ref": "urn:neko:schema:simulation-components#/$defs/nonEmptyString"
            }
          },
          "oneOf": [
            {
              "properties": {
                "model": {
                  "const": "entropy_viscosity"
                },
                "c_avisc_low": {
                  "type": "number",
                  "x-neko-real": true
                },
                "c_avisc_entropy": {
                  "type": "number",
                  "x-neko-real": true
                }
              }
            },
            {
              "description": "A model registered through the extension mechanism, which defines its own keys.",
              "properties": {
                "model": {
                  "$ref": "urn:neko:schema:simulation-components#/$defs/nonEmptyString"
                }
              },
              "not": {
                "properties": {
                  "model": {
                    "enum": ["entropy_viscosity"]
                  }
                },
                "required": ["model"]
              }
            }
          ],
          "additionalProperties": true
        }
      ]
    }
  }
}
